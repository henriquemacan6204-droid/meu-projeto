{
  "manifest_version": 2,
  "name": "Luma Glass AdBlock",
  "version": "1.0.0",
  "description": "Bloqueio local de domínios conhecidos de publicidade e rastreamento",
  "applications": {
    "gecko": {
      "id": "glassblock@lumaglass.local"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "block.js"
    ]
  }
}
